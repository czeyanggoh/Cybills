# Copy to server/.env for local dev. Never commit the real .env.
PORT=3004
NODE_ENV=development

# Public origin the app is served from (used for OAuth redirect + post-login
# redirect). Prod: https://cybills.cy-bm.sg
APP_ORIGIN=http://localhost:5173

# --- Google OAuth (real sign-in) ------------------------------------------
# Leave blank to keep the frontend's mock sign-in. Fill all three (+ a session
# secret) to switch on real Google sign-in. Values come from a Google Cloud
# OAuth 2.0 "Web application" client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# Prod: https://cybills.cy-bm.sg/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Long random string used to sign the session cookie, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Optional: restrict sign-in to one Google Workspace domain, e.g. cy-bm.sg.
ALLOWED_HOSTED_DOMAIN=
