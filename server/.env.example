# Copy to server/.env for local dev. Never commit the real .env.
PORT=3004
NODE_ENV=development

# Public origin the app is served from (used for OAuth redirect + post-login
# redirect). Prod: https://cybills.cy-bm.sg
APP_ORIGIN=http://localhost:5173

# --- Google OAuth (real sign-in) ------------------------------------------
# Leave blank to keep the frontend's mock sign-in. Fill all three (+ a session
# secret) to switch on real Google sign-in. Values come from a Google Cloud
# OAuth 2.0 "Web application" client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# Prod: https://cybills.cy-bm.sg/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Long random string used to sign the session cookie, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Optional: restrict sign-in to one Google Workspace domain, e.g. cy-bm.sg.
ALLOWED_HOSTED_DOMAIN=

# --- Document reader (receipt / invoice auto-fill) ------------------------
# Two interchangeable engines read uploaded documents: OpenAI and Claude. Either
# key alone switches auto-fill on; with both configured, Business settings ->
# Extraction -> "Document reader" lets each client entity pick. Leave both blank
# to keep extraction disabled (the UI shows a "not configured" note).

# OpenAI is the default reader. Get a key from https://platform.openai.com.
OPENAI_API_KEY=
# Optional: override the extraction model (must accept image + PDF input).
# The GPT-5.6 tier, as OpenAI positions the two:
#   gpt-5.6-luna  ($0.20/$1.20 per M) — bulk text extraction, routing,
#                 classification. The default: cheapest and fastest.
#   gpt-5.6-terra ($2/$12 per M) — standard document summaries, invoice
#                 parsing. Worth the 10x if documents are coming back misread.
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
# Optional: how hard a reasoning model thinks before answering. 'low' is plenty
# for reading a document; raise to 'medium' for awkward layouts. Accepted values
# differ by family (GPT-5.6: none/low/medium/high/xhigh/max; GPT-5:
# minimal/low/medium/high) and the model rejects one it doesn't know.
OPENAI_REASONING_EFFORT=low
# Optional: point at an OpenAI-compatible gateway. Blank = api.openai.com.
OPENAI_BASE_URL=

# Claude. Get a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: override the model. Defaults to claude-opus-4-8; use
# claude-sonnet-5 for a cheaper/faster option.
ANTHROPIC_MODEL=claude-opus-4-8
# Optional: the model used for extraction specifically. Defaults to
# claude-sonnet-5.
ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5

# Which reader a request that doesn't name one gets: openai (default) or claude.
# Ignored when the named provider has no key — the configured one is used
# instead, so this can't strand extraction.
LLM_PROVIDER=openai

# --- Bills store ----------------------------------------------------------
# Where the persisted-bills JSON file lives (uploaded cost documents + the
# duplicate-detection index). Leave blank to default to server/.data
# (gitignored, survives the deploy's `git reset --hard`).
BILLS_DATA_DIR=

# --- Xero via cyworkspace relay --------------------------------------------
# CYBills never holds Xero credentials; it posts supplier bills through
# cyworkspace's authenticated Xero relay. Set the relay origin (on the shared
# VPS use http://127.0.0.1:3001 to skip the public round trip) and the shared
# webhook API key (cyworkspace server/.env WEBHOOK_API_KEY). Leave the key
# blank to keep Xero features disabled (endpoints return 503).
CYWORKSPACE_RELAY_URL=https://cyworkspace.cy-bm.sg
CYWORKSPACE_API_KEY=

# --- Cloudflare R2 (original bill files) ----------------------------------
# Object storage for the uploaded file bytes; the JSON store only keeps
# metadata + a hash. Set ALL FOUR to switch on file storage — until then
# uploads still persist metadata + run duplicate detection, just without a
# retrievable original. Create an R2 bucket + an API token (Object Read & Write)
# in the Cloudflare dashboard. R2_ACCOUNT_ID is your Cloudflare account id.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- CYHR handoff (signed deep links) -------------------------------------
# CYBills captures the receipt + Xero category, then deep-links the employee
# into CYHR where the claim lands prefilled to submit/approve. The link is
# HMAC-SHA256 signed with a secret SHARED with CYHR (identical value on both
# sides) so params can't be altered en route. The secret is used only on the
# server to compute the signature — it never reaches the browser. The action
# switches on once CYHR_SIGNING_SECRET is set (URL already defaults to CYHR's
# confirmed form). Paste the shared secret here directly on the VPS — never
# send it over chat/WhatsApp. It must be byte-identical to CYHR's copy.
# CYHR_BASE_URL defaults to https://hr.cy-bm.sg/claims/expenses/new; override
# only if CYHR moves the form.
CYHR_BASE_URL=
CYHR_SIGNING_SECRET=

# --- Outbound email (Microsoft Graph, delegated) ----------------------------
# Account email — invitations, password resets, password-changed notices — is
# sent from a Microsoft 365 mailbox via Graph's sendMail, using DELEGATED auth:
# the app sends AS a signed-in Microsoft user, so it can only ever touch the one
# mailbox whose owner consented, and cannot read anything in it.
#
# Create an Azure app registration at https://entra.microsoft.com (Identity >
# Applications > App registrations) and give it the Microsoft Graph `Mail.Send`
# DELEGATED permission (NOT the Application one — that is tenant-wide). Then an
# admin connects the mailbox once from Settings > Email. Full walkthrough in
# deploy/EMAIL.md.
#
#   GRAPH_TENANT_ID     Overview blade > Directory (tenant) ID
#   GRAPH_CLIENT_ID     Overview blade > Application (client) ID
#   GRAPH_CLIENT_SECRET Certificates & secrets > Client secrets > the "Value"
#   GRAPH_REDIRECT_URI  must EXACTLY match a "Web" redirect URI on the app
#                       Prod: https://cybills.cy-bm.sg/api/mail/callback
#
# Leave blank to keep email off: invite/reset links are still generated and
# handed back to the admin to share manually.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REDIRECT_URI=http://localhost:5173/api/mail/callback
# Optional: send from a SHARED mailbox (e.g. no-reply@cy-bm.sg) rather than the
# connecting admin's own address. Requires the `Mail.Send.Shared` delegated
# permission on the app AND "Send As" rights on that mailbox for whoever
# connects — still delegated, still not tenant-wide. Blank = send as the
# connected user.
GRAPH_SHARED_SENDER=
# Optional Reply-To, so replies to a no-reply sender reach a real inbox.
MAIL_REPLY_TO=
# How many days an invitation / password-reset link stays valid (default 7).
INVITE_TTL_DAYS=7

# --- Admin recovery (break-glass) -----------------------------------------
# Comma-separated emails always treated as account owners (Admin role), e.g.
# czeyang.goh@cy-bm.sg,astrid@cy-bm.sg. The roster already pins the two seeded
# owners, but an owner who signed up through /join under a different address
# lands as Standard — which hides Users and Business settings from them with no
# explanation. List them here and their row is promoted on the next request.
# Only ever promotes; nobody is demoted. Leave blank if the seed is enough.
OWNER_EMAILS=
